# FR 2052a — Server 1 环境变量模板
#
# 用法：复制为 .env 并填入真实值。.env 含明文凭据，不入版本库。
# 口令生成：openssl rand -base64 24 | tr -d '/+=' | cut -c1-24

TZ=Asia/Shanghai

# ---- PostgreSQL：ADS 报表服务层 + 审计层 ----
POSTGRES_USER=fr2052a
POSTGRES_PASSWORD=<在这里填口令>
POSTGRES_DB=fr2052a_db
POSTGRES_PORT=5432

# ---- MinIO：Iceberg 数据湖对象存储 ----
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=fr2052a
MINIO_ROOT_PASSWORD=<在这里填口令>
MINIO_BUCKET=fr2052a-bucket
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Airflow：调度编排 ----
AIRFLOW_IMAGE=apache/airflow:2.10.5-python3.11
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=<在这里填口令>
# 会话签名密钥：openssl rand -hex 16
AIRFLOW_SECRET_KEY=<在这里填密钥>

# ---- 跨机触发 ----
# Airflow 的 DAG 通过 SSH 触发 Server 2 上的跑批脚本
SERVER2_HOST=192.168.17.24
SERVER2_SSH_USER=hermes
