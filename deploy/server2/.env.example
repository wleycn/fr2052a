# FR 2052a — Server 2 环境变量模板
#
# 用法：复制为 .env 并填入真实值。.env 含明文凭据，不入版本库。

TZ=Asia/Shanghai

# Kafka 对外通告地址使用的主机
SERVER2_HOST=192.168.17.24

# Spark Worker 资源上限
# 机器为 8 核 / 15Gi；留出余量给 Kafka 与操作系统。
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=6g

# ---- 跨机依赖：Server 1 的 PostgreSQL 与 MinIO ----
# 供 spark-submit-fr2052a.sh 注入 Iceberg catalog 与对象存储的凭据。
# 取值必须与 Server 1 的 deploy/server1/.env 保持一致。
SERVER1_HOST=192.168.17.22
POSTGRES_USER=fr2052a
POSTGRES_PASSWORD=<与 Server 1 的 POSTGRES_PASSWORD 一致>
POSTGRES_DB=fr2052a_db
MINIO_ROOT_USER=fr2052a
MINIO_ROOT_PASSWORD=<与 Server 1 的 MINIO_ROOT_PASSWORD 一致>
