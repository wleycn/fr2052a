#!/usr/bin/env sh
# commit message 闸：agent 会话的提交必须以 [AI] 开头，人工提交不带标记。
#
# 为什么单独一道：pre-commit 看代码，这道看「这条提交是谁产生的」。
# AGENTS.md 要求 agent 提交带 [AI]、人工提交不带，靠自觉必然漂移，所以放进钩子。
#
# 启用（每个克隆各一次）：git config core.hooksPath .githooks
# 跳过（确知后果时）：git commit --no-verify
set -e
message_file="$1"

# HERMES_AGENT 由 agent 运行环境注入；普通终端里没有这个变量，人工提交不受影响。
if [ -n "${HERMES_AGENT:-}" ]; then
    if ! grep -q '^\[AI\]' "$message_file"; then
        echo "提交被拦下：agent 会话的 commit message 必须以 [AI] 开头。" >&2
        exit 1
    fi
fi
